# MySQL 8.0 — 商户、权限、游戏字典、对账单
# 默认 13306，避免与本机 MySQL 3306 冲突
MYSQL_PORT=13306
MYSQL_ROOT_PASSWORD=fastgame_root
MYSQL_DATABASE=fastgame
MYSQL_USER=fastgame
MYSQL_PASSWORD=fastgame_pass

# Redis — 分布式锁、幂等 Token、实时排行榜
# 默认 16379，避免与本机 Redis 6379 冲突
REDIS_PORT=16379

# ClickHouse — 海量注单明细与 RTP 分析
CLICKHOUSE_HTTP_PORT=18123
CLICKHOUSE_NATIVE_PORT=19000
CLICKHOUSE_DATABASE=fastgame
CLICKHOUSE_USER=fastgame
CLICKHOUSE_PASSWORD=fastgame_pass

# Kafka — 异步结算事件管道 (Snappy 压缩)
KAFKA_PORT=19092

# API Gateway (Nginx 统一入口)
GATEWAY_PORT=18000

# 开发辅助工具 (可选)
KAFKA_UI_PORT=18080
ADMINER_PORT=18081
REDIS_INSIGHT_PORT=15540
