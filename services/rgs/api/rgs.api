syntax = "v1"

info (
	title:   "FastGame RGS Settlement API"
	desc:    "核心游戏结算引擎 - 胖服务端瘦客户端，100% 服务端判定"
	author:  "leon"
	version: "v1"
)

type (
	SessionReq {
		MerchantId string `json:"merchantId" validate:"required"`
		UserId     uint64 `json:"userId" validate:"required"`
		GameCode   string `json:"gameCode" validate:"required"`
		ClientSeed string `json:"clientSeed,optional"`
	}
	SessionResp {
		SessionToken      string `json:"sessionToken"`
		ServerSeedHash    string `json:"serverSeedHash"`
		ClientSeed        string `json:"clientSeed"`
		DynamicSessionKey string `json:"dynamicSessionKey"`
		NextSequenceId    uint64 `json:"nextSequenceId"`
		ExpiresAt         int64  `json:"expiresAt"`
	}
	// 客户端仅上报：action(cast) + betAmount + roundId + sequenceId
	BetReq {
		MerchantId       string  `json:"merchantId" validate:"required"`
		UserId           uint64  `json:"userId" validate:"required"`
		SessionToken     string  `json:"sessionToken" validate:"required"`
		GameCode         string  `json:"gameCode" validate:"required"`
		Action           string  `json:"action" validate:"required"`
		BetAmount        int64   `json:"betAmount" validate:"required,gt=0"`
		RoundId          string  `json:"roundId" validate:"required"`
		SequenceId       uint64  `json:"sequenceId" validate:"required"`
		IdempotencyToken string  `json:"idempotencyToken,optional"`
		ClientSeed       string  `json:"clientSeed,optional"`
	}
	ProvablyFairProof {
		ServerSeedHash string  `json:"serverSeedHash"`
		ServerSeed     string  `json:"serverSeed"`
		ClientSeed     string  `json:"clientSeed"`
		Nonce          string  `json:"nonce"`
		Roll           float64 `json:"roll"`
	}
	ReplayInputs {
		ServerSeed string  `json:"serverSeed"`
		ClientSeed string  `json:"clientSeed"`
		Nonce      string  `json:"nonce"`
		BetAmount  int64   `json:"betAmount"`
	}
	ReplayPoint {
		X float64 `json:"x"`
		Y float64 `json:"y"`
	}
	ReplayScene {
		Weather        string        `json:"weather"`
		FishSpecies    string        `json:"fishSpecies"`
		FishPath       []ReplayPoint `json:"fishPath"`
		BiteProp       string        `json:"biteProp"`
		CastDurationMs int           `json:"castDurationMs"`
		FishSpeed      float64       `json:"fishSpeed"`
	}
	ReplayPayload {
		Inputs ReplayInputs `json:"inputs"`
		Scene  ReplayScene  `json:"scene"`
	}
	BetResp {
		RoundId      string            `json:"roundId"`
		WinAmount    int64             `json:"winAmount"`
		Multiplier   int64             `json:"multiplier"`
		Balance      int64             `json:"balance"`
		RtpTier      string            `json:"rtpTier"`
		FishState    string            `json:"fishState"`
		AnimationKey string            `json:"animationKey"`
		SequenceId   uint64            `json:"sequenceId"`
		ProvablyFair ProvablyFairProof `json:"provablyFair"`
		Replay       ReplayPayload     `json:"replay"`
	}
	ReplayReq {
		RoundId string `path:"roundId"`
	}
	ReplayComputeReq {
		ServerSeed string  `json:"serverSeed" validate:"required"`
		ClientSeed string  `json:"clientSeed" validate:"required"`
		Nonce      string  `json:"nonce" validate:"required"`
		BetAmount  int64   `json:"betAmount" validate:"required,gt=0"`
		RtpTier    string  `json:"rtpTier,optional"`
	}
	ReplayResp {
		RoundId      string            `json:"roundId,omitempty"`
		SequenceId   uint64            `json:"sequenceId,omitempty"`
		Replay       ReplayPayload     `json:"replay"`
		ProvablyFair ProvablyFairProof `json:"provablyFair"`
		WinAmount    int64             `json:"winAmount"`
		Multiplier   int64             `json:"multiplier"`
		FishState    string            `json:"fishState"`
		AnimationKey string            `json:"animationKey"`
	}
	BalanceReq {
		MerchantId string `form:"merchantId" validate:"required"`
		UserId     uint64 `form:"userId" validate:"required"`
	}
	BalanceResp {
		Balance int64   `json:"balance"`
	}
)

@server (
	prefix: /api/v1
)
service rgs-api {
	@doc "创建游戏会话"
	@handler Session
	post /game/session (SessionReq) returns (SessionResp)

	@doc "玩家抛竿/下注并结算"
	@handler Bet
	post /game/bet (BetReq) returns (BetResp)

	@doc "查询玩家余额"
	@handler Balance
	get /game/balance (BalanceReq) returns (BalanceResp)

	@doc "按 Round ID 获取确定性回放数据"
	@handler Replay
	get /game/replay/:roundId (ReplayReq) returns (ReplayResp)

	@doc "从种子计算确定性回放（无需 DB）"
	@handler ReplayCompute
	post /game/replay/compute (ReplayComputeReq) returns (ReplayResp)
}
